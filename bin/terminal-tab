#!/usr/bin/env bash
# Open a new terminal tab in whichever terminal this shell runs in, cmux or
# Ghostty. All arguments are passed through to cmux-tab or ghostty-tab.
#
# cmux embeds Ghostty and sets TERM_PROGRAM=ghostty, so check for cmux's own
# environment instead.
if [[ -n ${CMUX_WORKSPACE_ID:-} ]]; then
    exec cmux-tab "$@"
else
    exec ghostty-tab "$@"
fi
